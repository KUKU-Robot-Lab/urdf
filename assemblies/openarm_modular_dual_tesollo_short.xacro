<?xml version="1.0"?>
<robot name="openarm_dual_tesollo_short" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Modular dual configuration (DG5F short base):
      - Left: OpenArm with Tesollo DG-5F 20-DoF left hand, short mount/base
      - Right: OpenArm with Tesollo DG-5F 20-DoF right hand, short mount/base

    Notes
      - Uses the stock OpenArm dual-arm body with built-in end-effectors disabled
      - Adds stable palm alias frames and palm EE frames for both hands
      - Mount transforms are exposed for quick tuning in Isaac Sim / training assets
      - Hand fragments come from eef/dg5f_short/*.xacro (generated by
        tools/gen_dg5f_short_xacro.py from vendor/tesollo_model/dg5f, the CAD
        release - NOT the dg_description / dg5f_ros2 driver copies, which ship
        the same hand with rounded placeholder masses and different limits)
      - Finger kinematics are identical to the DG5F assembly; only *_dg_palm
        moves 47.8mm towards the flange (z 0.0698 -> 0.022) and the mount/base
        masses and meshes differ, so every downstream joint/link name is shared
  -->

  <!-- External dependencies -->
  <xacro:include filename="$(find openarm_description)/urdf/robot/openarm_robot.xacro"/>

  <!-- DG-5F-M-short <-> OpenArm 플랜지 어댑터 판(사용자 지시 09.10) -->
  <xacro:include filename="../eef/dg5f_m_short_adaptor.xacro"/>

  <!-- Tesollo wrappers -->
  <xacro:include filename="../eef/tesollo_left_wrapper.xacro"/>
  <xacro:include filename="../eef/tesollo_right_wrapper.xacro"/>

  <!-- Compatibility args for upstream xacro that incorrectly uses $(eval hand/ee_type). -->
  <xacro:arg name="hand" default="false"/>
  <xacro:arg name="ee_type" default="none"/>

  <!-- Mount transforms -->
  <xacro:arg name="left_mount_xyz" default="0 0 0.0495"/>
  <xacro:arg name="left_mount_rpy" default="0 0 1.5707964"/>
  <xacro:arg name="right_mount_xyz" default="0 0.0000003 0.0495"/>
  <xacro:arg name="right_mount_rpy" default="0 0 -1.5707964"/>

  <!-- Optional: upstream Tesollo xacro paths (generated DG5F short fragments) -->
  <xacro:arg name="left_tesollo_xacro" default="/home/user/rl_ws/urdf/eef/dg5f_short/dg5f_left_short.xacro"/>
  <xacro:arg name="right_tesollo_xacro" default="/home/user/rl_ws/urdf/eef/dg5f_short/dg5f_right_short.xacro"/>

  <!-- Optional: training palm-center frames -->
  <xacro:arg name="left_palm_ee_xyz" default="0.028 0 0.04"/>
  <xacro:arg name="right_palm_ee_xyz" default="0.028 0 0.04"/>

  <!-- Instantiate the stock OpenArm dual-arm body, but omit built-in hands. -->
  <xacro:openarm_robot
    arm_type="v10"
    body_type="v10"
    joint_limits="${xacro.load_yaml('$(find openarm_description)/config/arm/v10/joint_limits.yaml')}"
    control_gains="${xacro.load_yaml('$(find openarm_description)/config/arm/v10/control_gains.yaml')}"
    inertials="${xacro.load_yaml('$(find openarm_description)/config/arm/v10/inertials.yaml')}"
    kinematics="${xacro.load_yaml('$(find openarm_description)/config/arm/v10/kinematics.yaml')}"
    kinematics_link="${xacro.load_yaml('$(find openarm_description)/config/arm/v10/kinematics_link.yaml')}"
    kinematics_offset="${xacro.load_yaml('$(find openarm_description)/config/arm/v10/kinematics_offset.yaml')}"
    body_inertials="${xacro.load_yaml('$(find openarm_description)/config/body/v10/inertials.yaml')}"
    body_kinematics="${xacro.load_yaml('$(find openarm_description)/config/body/v10/kinematics.yaml')}"
    body_kinematics_link="${xacro.load_yaml('$(find openarm_description)/config/body/v10/kinematics.yaml')}"
    ee_kinematics_link="${xacro.load_yaml('$(find openarm_description)/config/hand/openarm_hand/kinematics_link.yaml')}"
    hand="false"
    ee_type="none"
    ros2_control="false"
    can_interface="can0"
    left_can_interface="can1"
    right_can_interface="can0"
    left_arm_prefix="left_"
    right_arm_prefix="right_"
    use_fake_hardware="false"
    fake_sensor_commands="false"
    no_prefix="false"
    arm_prefix=""
    body_prefix=""
    arm_connected_to="base"
    body_connected_to="world"
    bimanual="true"
    right_arm_base_xyz="0.0 -0.031 0.698"
    left_arm_base_xyz="0.0 0.031 0.698"
    right_arm_base_rpy="1.5708 0 0"
    left_arm_base_rpy="-1.5708 0 0"
    can_fd="true"
  />

  <!-- LEFT: Tesollo left hand on openarm_left_link7 -->
  <xacro:tesollo_left_with_frames
    prefix="left_"
    tesollo_xacro="$(arg left_tesollo_xacro)"
    palm_com_xyz="$(arg left_palm_ee_xyz)"
  />

  <xacro:dg5f_m_short_adaptor prefix="left_"/>

  <joint name="mount_left_link7_to_adaptor" type="fixed">
    <parent link="openarm_left_link7"/>
    <child  link="left_dg5f_short_adaptor"/>
    <origin xyz="$(arg left_mount_xyz)" rpy="$(arg left_mount_rpy)"/>
  </joint>

  <joint name="mount_left_adaptor_to_tesollo" type="fixed">
    <parent link="left_dg5f_short_adaptor"/>
    <child  link="left_base_link"/>
    <origin xyz="0 0 ${dg5f_short_adaptor_thickness}" rpy="0 0 0"/>
  </joint>

  <!-- RIGHT: Tesollo right hand on openarm_right_link7 -->
  <xacro:tesollo_right_with_frames
    prefix="right_"
    tesollo_xacro="$(arg right_tesollo_xacro)"
    palm_com_xyz="$(arg right_palm_ee_xyz)"
  />

  <!-- ★09.10 어댑터 판을 플랜지와 손 마운트 **사이**에 끼운다. 회전은 종전과 같은
       자리(플랜지->어댑터)에 두고, 어댑터->손은 판 두께 10mm 만 더한다. 판은 55x55
       정사각이라 z 회전은 기하에 영향이 없다. 결과로 손이 플랜지에서 10mm 멀어진다. -->
  <xacro:dg5f_m_short_adaptor prefix="right_"/>

  <joint name="mount_right_link7_to_adaptor" type="fixed">
    <parent link="openarm_right_link7"/>
    <child  link="right_dg5f_short_adaptor"/>
    <origin xyz="$(arg right_mount_xyz)" rpy="$(arg right_mount_rpy)"/>
  </joint>

  <joint name="mount_right_adaptor_to_tesollo" type="fixed">
    <parent link="right_dg5f_short_adaptor"/>
    <child  link="right_base_link"/>
    <origin xyz="0 0 ${dg5f_short_adaptor_thickness}" rpy="0 0 0"/>
  </joint>

</robot>
