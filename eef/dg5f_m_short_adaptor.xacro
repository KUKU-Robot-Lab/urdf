<?xml version="1.0"?>
<!--
  DG-5F-M-short <-> OpenArm 플랜지 어댑터 판.

  왜 필요한가: dg5f-m-short 는 마운트/베이스 구간이 짧아 OpenArm link7 플랜지에 직접
  물리지 않는다. 이 판이 둘 사이를 잇는다(사용자 지시 2026-09-10).

  기하: vendor/dg5f_m_short_adaptor/meshes 의 실측 — 55 x 55 x 10 mm 평판(메시 z 0->10).
        메시 단위는 **mm** 이므로 scale 0.001 이 필수다.
        결합면: z=0 이 팔 플랜지 쪽, z=10 이 손 마운트 쪽.

  질량/관성은 **벤더값**이다 — vendor/dg5f_m_short_adaptor/usd/dg5f_m_short_adaptor.usda
    (Tesollo 가 Fusion 에서 덤프: "Meters, Z-up. Origin = bottom mounting face centre.
     Threads removed; same mesh as the STL/DAE."):
        physics:mass           0.031642 kg   (PLA 1.24 g/cm^3, 나사산 포함 실형상 기준)
        physics:centerOfMass   (0, 0, 0.004979)
        physics:diagonalInertia (8.695287e-06, 8.695495e-06, 1.68636e-05)  principalAxes 단위
        physics:approximation  convexHull    (우리 자산 기본값과 일치)
    ★09.10 첫 판에서 재질을 몰라 알루미늄 6061 로 추정해 0.06912 kg 을 넣었다 — **2.18배
      과대**였다. 벤더 USD 를 확인하니 PLA 였다. 우리 메시 적분값을 PLA 밀도로 환산하면
      벤더 관성과 소수 4자리까지 일치하므로 형상 해석 자체는 맞았고 밀도만 틀렸다.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dg5f_m_short_adaptor">

  <xacro:property name="dg5f_short_adaptor_thickness" value="0.010"/>
  <xacro:property name="dg5f_short_adaptor_mass" value="0.031642"/>
  <xacro:property name="dg5f_short_adaptor_dir"
                 value="/home/user/rl_ws/urdf/vendor/dg5f_m_short_adaptor/meshes"/>

  <xacro:macro name="dg5f_m_short_adaptor" params="prefix:=''">
    <link name="${prefix}dg5f_short_adaptor">
      <inertial>
        <origin xyz="0 0 0.004979" rpy="0 0 0"/>
        <mass value="${dg5f_short_adaptor_mass}"/>
        <inertia ixx="8.695287e-06" ixy="0.0" ixz="0.0"
                 iyy="8.695495e-06" iyz="0.0" izz="1.68636e-05"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://${dg5f_short_adaptor_dir}/visual/dg5f_m_short_adaptor.dae"
                scale="0.001 0.001 0.001"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://${dg5f_short_adaptor_dir}/collision/dg5f_m_short_adaptor.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

</robot>
